# Origin Kernel for the CMF Phone 1 (Tetris), Magisk build.
#
# Merged over Origin's Tetris-v1 gki_defconfig. Everything Origin adds stays (CASS, BBRv3,
# ThinLTO, ZRAM LZ4, IPv6 NAT, Droidspaces); only the in-kernel root and the partition-write
# guard are off, so Magisk (in init_boot) is the only root and can still update itself.

# KernelSU-Next is on by its own Kconfig default; SUSFS depends on it.
# CONFIG_KSU is not set
# CONFIG_KSU_SUSFS is not set

# Baseband-Guard is on by its own Kconfig default. It denies root writes to boot partitions,
# which is how Magisk's "Direct install" updates itself.
# CONFIG_BBG is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf"

# Trust the stock kernel's module-signing certificate (Nothing OS B4.1-260615-1652, kernel
# 6.1.162-android14-11-g65896c4edca1-ab15242664), so the Google-signed modules in system_dlkm
# keep their signed status under CONFIG_MODULE_SIG_PROTECT (otherwise they may not export
# protected symbols and fail to load).
CONFIG_SYSTEM_TRUSTED_KEYS="certs/stock-gki-signing.pem"

# On in the stock kernel (Google's build turns it on outside gki_defconfig, so Origin's plain make
# leaves it off): unsigned vendor modules may only use the KMI symbol lists and may not override
# exports of the signed GKI modules. The checks verify every stock module stays within it.
CONFIG_MODULE_SIG_PROTECT=y

# The stock kernel's release name (uname -r, module vermagic), so the kernel looks to Android and
# its modules exactly like the one it replaces. Google's build adds "-android14-11-g<sha>-ab<build>";
# a plain make does not (the workflow passes LOCALVERSION= and BUILD_NUMBER=15242664, giving
# 6.1.162-android14-11-g65896c4edca1-ab15242664).
CONFIG_LOCALVERSION="-android14-11-g65896c4edca1"
# CONFIG_LOCALVERSION_AUTO is not set
